# ==============================================================================
# MeetingOS Configuration Contract (.env.example)
# ==============================================================================
# This file serves as the canonical environment configuration template.
# Copy this file to .env and adjust variables for your target deployment environment.
# NEVER commit real credentials, production secrets, or private API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Security Settings
# ------------------------------------------------------------------------------
APP_NAME="MeetingOS API"
APP_VERSION="1.0.0-rc1"
# Environment mode: development | test | staging | production
APP_ENV=development
# Debug mode: Set to false in production
APP_DEBUG=true
# API route prefix
API_V1_PREFIX=/api/v1
# Production secret key (Must be non-default and >= 16 characters in production)
MEETINGOS_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
# Allowed CORS origins as JSON list string (e.g., ["https://app.meetingos.internal"])
MEETINGOS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Async SQLAlchemy connection URL
DATABASE_URL=postgresql+asyncpg://meetingos:meetingos_secret_password@localhost:5432/meetingos_db
# Docker Compose Postgres variables
POSTGRES_USER=meetingos
POSTGRES_PASSWORD=meetingos_secret_password
POSTGRES_DB=meetingos_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Cache & Background Task Queue (Redis + Celery)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Storage & Ingestion Limits
# ------------------------------------------------------------------------------
UPLOAD_STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=500

# ------------------------------------------------------------------------------
# 5. Production Rate Limiting (Requests per minute)
# ------------------------------------------------------------------------------
MEETINGOS_RATE_LIMIT_QUERY=60
MEETINGOS_RATE_LIMIT_UPLOAD=10
MEETINGOS_RATE_LIMIT_AGENTIC=20
MEETINGOS_RATE_LIMIT_ADMIN=30

# ------------------------------------------------------------------------------
# 6. Speech & Fact Extraction Providers (ASR, Diarization, NER)
# ------------------------------------------------------------------------------
# Provider options: mock | whisper | local
ASR_PROVIDER=mock
DIARIZER_PROVIDER=mock
NER_PROVIDER=mock
CLASSIFIER_PROVIDER=mock

# ------------------------------------------------------------------------------
# 7. Scalable Hardware & Worker Queues
# ------------------------------------------------------------------------------
# Hardware acceleration device: cpu | cuda | auto
MEETINGOS_ASR_DEVICE=cpu
MEETINGOS_ASR_WORKERS=1
MEETINGOS_NLP_WORKERS=2
MEETINGOS_EMBEDDING_WORKERS=2

# ------------------------------------------------------------------------------
# 8. Embedding Provider Configuration
# ------------------------------------------------------------------------------
# Provider options: mock | local | local_semantic | sentence_transformers | openai | gemini
MEETINGOS_EMBEDDING_PROVIDER=mock
MEETINGOS_EMBEDDING_MODEL=local-semantic-v1
# Required only if MEETINGOS_EMBEDDING_PROVIDER is 'openai' or 'openai_compatible'
MEETINGOS_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEETINGOS_EMBEDDING_API_KEY=your-embedding-api-key-here

# ------------------------------------------------------------------------------
# 9. Reasoning & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider options: mock | local | local_evidence | openai | anthropic | gemini
MEETINGOS_REASONER_PROVIDER=mock
MEETINGOS_REASONER_MODEL=local-reasoner-v1
# Required only if MEETINGOS_REASONER_PROVIDER is 'openai' or 'openai_compatible'
MEETINGOS_REASONER_BASE_URL=https://api.openai.com/v1
MEETINGOS_REASONER_API_KEY=your-reasoner-api-key-here

# ------------------------------------------------------------------------------
# 10. Anthropic Claude Provider Configuration
# ------------------------------------------------------------------------------
MEETINGOS_ANTHROPIC_API_KEY=your-anthropic-api-key-here
MEETINGOS_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
MEETINGOS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# 11. Google Gemini Provider Configuration
# ------------------------------------------------------------------------------
MEETINGOS_GEMINI_API_KEY=your-gemini-api-key-here
MEETINGOS_GEMINI_MODEL=gemini-1.5-flash
MEETINGOS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ------------------------------------------------------------------------------
# 12. External Connectors (Teams, Zoom, Google Meet)
# ------------------------------------------------------------------------------
# Microsoft Teams Graph Connector
TEAMS_ENABLED=false
TEAMS_TENANT_ID=your-teams-tenant-id-here
TEAMS_CLIENT_ID=your-teams-client-id-here
TEAMS_CLIENT_SECRET=your-teams-client-secret-here

# Zoom Cloud OAuth Connector
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=your-zoom-account-id-here
ZOOM_CLIENT_ID=your-zoom-client-id-here
ZOOM_CLIENT_SECRET=your-zoom-client-secret-here

# Google Meet Calendar/Drive Connector
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
