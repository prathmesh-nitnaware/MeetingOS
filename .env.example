# ==============================================================================
# MeetingOS Environment Configuration Template
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-meetingos-secret-key-32chars

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=meetingos
POSTGRES_PASSWORD=meetingos_secret_password
POSTGRES_DB=meetingos_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetingos:meetingos_secret_password@localhost:5432/meetingos_db
DATABASE_SYNC_URL=postgresql+psycopg://meetingos:meetingos_secret_password@localhost:5432/meetingos_db

# Redis & Celery Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage & File Uploads
UPLOAD_STORAGE_DIR=./data/uploads
AUDIO_PROCESSING_DIR=./data/processing
MAX_UPLOAD_SIZE_MB=500

# Speech & Audio Processing (Pluggable BaseASR / BaseDiarizer)
ASR_PROVIDER=faster-whisper
ASR_MODEL_NAME=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
HF_HOME=./model_cache

# NLP & Embeddings (Pluggable Providers)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION is configured based on benchmarked model selection

# LLM / Reasoning Provider (Pluggable BaseReasoner)
REASONER_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
