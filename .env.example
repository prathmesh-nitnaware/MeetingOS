# ==============================================================================
# MeetingOS Configuration Contract (.env.example)
# ==============================================================================
# Copy this file to .env and adjust it for your environment.
# NEVER commit real credentials, production secrets, or private API keys.
# Leave optional credentials EMPTY - placeholder text is treated as "not configured".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Security
# ------------------------------------------------------------------------------
APP_NAME="MeetingOS API"
APP_VERSION="1.0.0-rc1"
# development | test | staging | production
APP_ENV=development
# Must be false in production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# Signs login tokens. In production it must be random and at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEETINGOS_SECRET_KEY=dev-only-secret-key-not-for-production
# Login session lifetime in minutes
MEETINGOS_ACCESS_TOKEN_TTL_MINUTES=1440
# Hard-coded development sign-in tokens (admin-secret-token, ...). Only ever honoured when
# APP_ENV is development or test; always disabled in production.
MEETINGOS_ENABLE_DEV_AUTH=true
# Browser origins allowed to call the API (JSON list or comma separated)
MEETINGOS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://meetingos:meetingos_secret_password@localhost:5432/meetingos_db
# Docker Compose Postgres variables
POSTGRES_USER=meetingos
POSTGRES_PASSWORD=meetingos_secret_password
POSTGRES_DB=meetingos_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis & Background Workers (Celery)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Optional: separate broker / result store (default: REDIS_URL)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# false = background uploads run inside the API process (no worker needed)
MEETINGOS_USE_CELERY=true

# ------------------------------------------------------------------------------
# 4. Storage & Ingestion Limits
# ------------------------------------------------------------------------------
UPLOAD_STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=500

# ------------------------------------------------------------------------------
# 5. Rate Limiting (requests per minute, per signed-in user or client IP)
# ------------------------------------------------------------------------------
MEETINGOS_RATE_LIMITING_ENABLED=true
MEETINGOS_RATE_LIMIT_QUERY=60
MEETINGOS_RATE_LIMIT_UPLOAD=10
MEETINGOS_RATE_LIMIT_AGENTIC=20
MEETINGOS_RATE_LIMIT_ADMIN=30
MEETINGOS_RATE_LIMIT_LOGIN=10

# ------------------------------------------------------------------------------
# 6. Speech-to-Text
# ------------------------------------------------------------------------------
# whisper = real transcription with faster-whisper (install: uv sync --extra asr)
# mock    = canned demo transcript for every audio file (tests/demos only)
ASR_PROVIDER=whisper
# none = one speaker for the whole recording (real speaker separation is not included)
# mock = canned demo speaker names
DIARIZER_PROVIDER=none
# Whisper model size: tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
MEETINGOS_WHISPER_MODEL=base
# int8 is fastest on CPU; use float16 on a CUDA GPU
MEETINGOS_WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the spoken language (e.g. en, hi)
MEETINGOS_WHISPER_LANGUAGE=
# cpu | cuda | auto
MEETINGOS_ASR_DEVICE=cpu
MEETINGOS_ASR_WORKERS=1
MEETINGOS_NLP_WORKERS=2
MEETINGOS_EMBEDDING_WORKERS=2

# ------------------------------------------------------------------------------
# 7. Search Embeddings
# ------------------------------------------------------------------------------
# local | sentence_transformers | openai | gemini | mock
MEETINGOS_EMBEDDING_PROVIDER=local
MEETINGOS_EMBEDDING_MODEL=local-semantic-v1
# Only for openai / openai_compatible
MEETINGOS_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEETINGOS_EMBEDDING_API_KEY=

# ------------------------------------------------------------------------------
# 8. Question Answering (reasoner)
# ------------------------------------------------------------------------------
# local (offline, quotes evidence) | anthropic | openai | gemini | mock
MEETINGOS_REASONER_PROVIDER=local
MEETINGOS_REASONER_MODEL=local-reasoner-v1
# Only for openai / openai_compatible
MEETINGOS_REASONER_BASE_URL=https://api.openai.com/v1
MEETINGOS_REASONER_API_KEY=

# ------------------------------------------------------------------------------
# 9. Anthropic Claude (MEETINGOS_REASONER_PROVIDER=anthropic)
# ------------------------------------------------------------------------------
MEETINGOS_ANTHROPIC_API_KEY=
MEETINGOS_ANTHROPIC_MODEL=claude-opus-5-5
MEETINGOS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# 10. Google Gemini (reasoner and/or embeddings)
# ------------------------------------------------------------------------------
MEETINGOS_GEMINI_API_KEY=
MEETINGOS_GEMINI_MODEL=gemini-2.5-flash
MEETINGOS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MEETINGOS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ------------------------------------------------------------------------------
# 11. Data retention
# ------------------------------------------------------------------------------
# How often saved retention policies with auto-delete are applied
MEETINGOS_RETENTION_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# 12. External Connectors (Teams, Zoom, Google Meet)
# ------------------------------------------------------------------------------
# Live API integrations are NOT implemented yet. With client secret "mock-secret" a
# connector runs in demo mode and imports sample meetings.
TEAMS_ENABLED=false
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
